# ~/.config/i3d/70-hide-windows-by-title.starlark
#
# Hide windows whose titles match configured substrings or regular expressions.
# Each hidden window receives a unique i3 mark such as i3d-hidden-12345 before
# it is moved to the scratchpad, so any number of matching windows can coexist.
#
# i3 has one global scratchpad rather than truly named scratchpads. To prevent
# a normal scratchpad binding from showing these windows, mark user-controlled
# scratchpad windows and restrict the binding to that mark:
#
#   bindsym Mod3+Shift+s mark --add user-scratchpad, move scratchpad
#   bindsym Mod3+s [con_mark="^user-scratchpad$"] scratchpad show
#
# An unqualified `scratchpad show` can still reveal i3d-hidden-* windows.

priority = 50

# Each entry must contain exactly one of:
#   substring: a literal, case-sensitive fragment of the window title
#   regex:     an i3/PCRE regular expression matched against the title
#
# An entry may also constrain the X11 WM_CLASS class (its second value) with
# exactly one of these optional keys:
#   class_substring: a literal, case-sensitive fragment of WM_CLASS
#   class_regex:     an i3/PCRE regular expression matched against WM_CLASS
#
# Uncomment and customize entries as needed. Keeping the defaults commented
# makes it safe to copy or run the examples directory without hiding windows.
TITLE_MATCHES = [
    # {"substring": "Authentication Required"},
    # {
    #     "regex": "(?i)^update available(?: .*)?$",
    #     "class_substring": "Firefox",
    # },
    # {
    #     "substring": "Sign in",
    #     "class_regex": "(?i)^chromium$",
    # },
]

# Characters with special meaning in a PCRE pattern. Substring entries escape
# all of them so that a title fragment such as "file.txt" stays literal.
_REGEX_META = "\\.^$|?*+()[]{}"


def _escape_regex_literal(value):
    escaped = ""
    # go.starlark strings are intentionally not directly iterable. elems()
    # exposes their one-byte string elements for the ASCII PCRE metacharacters.
    for char in value.elems():
        if char in _REGEX_META:
            escaped += "\\"
        escaped += char
    return escaped


def _escape_i3_string(value):
    # Preserve regex backslashes while safely quoting an i3 criteria string.
    value = value.replace("\\", "\\\\")
    value = value.replace('"', '\\"')
    value = value.replace("\r", " ")
    value = value.replace("\n", " ")
    return value


def _pattern_from_keys(entry, substring_key, regex_key, required):
    substring = entry.get(substring_key, None)
    regex = entry.get(regex_key, None)

    if substring == None and regex == None:
        if required:
            log(
                "hide-windows-by-title: match entry must contain exactly one "
                + "of %s or %s: %s" % (substring_key, regex_key, str(entry))
            )
            return (False, None)
        return (True, None)

    if substring != None and regex != None:
        log(
            "hide-windows-by-title: match entry cannot contain both %s and %s: %s"
            % (substring_key, regex_key, str(entry))
        )
        return (False, None)

    if substring != None:
        if type(substring) != "string" or substring == "":
            log(
                "hide-windows-by-title: %s must be a non-empty string"
                % substring_key
            )
            return (False, None)
        return (True, _escape_regex_literal(substring))

    if type(regex) != "string" or regex == "":
        log(
            "hide-windows-by-title: %s must be a non-empty string"
            % regex_key
        )
        return (False, None)
    return (True, regex)


def _entry_patterns(entry):
    if type(entry) != "dict":
        log("hide-windows-by-title: match entry must be a dict: %s" % str(entry))
        return None

    title_ok, title_pattern = _pattern_from_keys(
        entry, "substring", "regex", True
    )
    if not title_ok:
        return None

    class_ok, class_pattern = _pattern_from_keys(
        entry, "class_substring", "class_regex", False
    )
    if not class_ok:
        return None

    return (title_pattern, class_pattern)


def _hide_if_window_matches(con_id, mark, title_pattern, class_pattern):
    # Let i3 evaluate the PCRE criteria. Combining them with con_id keeps the
    # command scoped to precisely the window that generated this event.
    criteria = '[con_id="%d" title="%s"' % (
        con_id,
        _escape_i3_string(title_pattern),
    )
    if class_pattern != None:
        criteria += ' class="%s"' % _escape_i3_string(class_pattern)
    criteria += "]"

    cmd = '%s mark --add "%s", move scratchpad' % (criteria, mark)
    if not i3.command(cmd):
        log(
            "hide-windows-by-title: i3 rejected title/class criteria: %s"
            % criteria
        )
        return False

    # A syntactically valid command also succeeds when its criteria match no
    # containers. The unique mark tells us whether this pattern really matched.
    return mark in i3.get_marks()


def on_window(e):
    # Many applications set their useful title only after the new event, so
    # inspect both creation and later title changes.
    if e.get("change", "") not in ("new", "title"):
        return

    con_id = e.get("con_id", None)
    if con_id == None:
        return

    mark = "i3d-hidden-%d" % con_id
    if mark in i3.get_marks():
        return

    for entry in TITLE_MATCHES:
        patterns = _entry_patterns(entry)
        if patterns == None:
            continue
        title_pattern, class_pattern = patterns
        if _hide_if_window_matches(
            con_id, mark, title_pattern, class_pattern
        ):
            if debug:
                log(
                    (
                        "hide-windows-by-title: moved con_id=%d to scratchpad "
                        + "with mark=%s"
                    )
                    % (con_id, mark)
                )
            return
